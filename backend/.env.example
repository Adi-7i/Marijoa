# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Application
APP_NAME=Marijoa Backend
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false

# API
API_V1_PREFIX=/api/v1

# Database — create the "Marijoa" database manually in PostgreSQL before running migrations
DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/Marijoa

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — use a strong random secret in staging/production
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000

# Storage
LOCAL_STORAGE_PATH=/tmp/marijoa/uploads
MAX_UPLOAD_SIZE_MB=20

# Logging
LOG_LEVEL=INFO
