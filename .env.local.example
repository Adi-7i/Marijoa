# Marijoa frontend environment configuration.
#
# Copy this file to `.env.local` and set the value for your environment.
# Only NEXT_PUBLIC_* variables are exposed to the browser bundle.
#
# Do NOT add any backend secrets, LLM API keys, Azure connection strings,
# Redis URLs, JWT secrets, or database credentials to this file.
# The frontend only needs to know the public backend API base URL.

# Base URL for the FastAPI backend, including the API version prefix.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
